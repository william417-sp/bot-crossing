{
  "name": "bot-crossing",
  "version": "0.1.0",
  "description": "Stark-style garage HQ visualization for William Rosado's AI agent team — portfolio MVP + real-time bot status tracking",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "preview": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
